FROM docker.io/oven/bun:1.3.10-debian@sha256:367842b35abbdf23f39e23c71f3a08eee940ff2679a14e08a5afcf4a1436cd89 AS bun

FROM docker.io/library/node:24-bookworm@sha256:8fa96264f302f58bbb13aa7339c541547b56975766ce956c875da149452a3e40

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s bun /usr/local/bin/bunx
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends podman libnss3-tools && rm -rf /var/lib/apt/lists/*

ENV HOME=/tmp
ENTRYPOINT []
CMD ["bun", "--version"]
