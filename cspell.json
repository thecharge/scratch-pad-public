{
  "version": "0.2",
  "language": "en",
  "dictionaries": ["softwareTerms", "typescript", "node", "npm", "project-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "node_modules",
    "bun.lock",
    "project-words.txt",
    "/.claude/worktrees",
    "openspec/changes/*/evidence/sources/**",
    "openspec/changes/archive/*/evidence/sources/**",
    "**/dist/**",
    ".cspellcache",
    "**/*.generated.ts",
    "packages/db/drizzle/**",
    "testing/integration/tooling/gates.test.ts",
    "apps/docs/src/content/docs/ui/**",
    "apps/docs/src/content/docs/api-calls/**",
    "apps/docs/src/content/docs/api-handling/**",
    "apps/docs/src/content/docs/troubleshooting/**",
    "apps/docs/src/content/docs/openapi/**",
    "apps/docs/src/content/docs/sdk-usage/reference.md",
    "apps/docs/dist/**",
    "packages/sdk/generated/**",
    "docs/e2e/**",
    "apps/docs/public/**",
    "apps/console/src/components/ui/**",
    "/.claude/commands",
    "/.claude/skills/openspec-*"
  ],
  "useGitignore": true,
  "failFast": false,
  "patterns": [
    {
      "name": "mermaid",
      "pattern": "/```mermaid[\\s\\S]*?```/g"
    }
  ],
  "ignoreRegExpList": ["mermaid"],
  "words": [
    "pids",
    "Asynch",
    "Containerfile",
    "Containerfiles",
    "Dex",
    "GODEBUG",
    "LDFLAGS",
    "Largefile",
    "Pulumi",
    "UNCONN",
    "USEPOLLING",
    "buildah",
    "chokidar",
    "crun",
    "datagrams",
    "dexidp",
    "fdinfo",
    "gcprofiler",
    "healthcheck",
    "inotify",
    "ipfs",
    "ipns",
    "kreuzwerker",
    "ldaps",
    "libidn",
    "libpsl",
    "longrunning",
    "mediatype",
    "netavark",
    "netdns",
    "nghttp",
    "ngtcp",
    "nslookup",
    "presign",
    "rtsp",
    "rustfs",
    "segs",
    "starttransfer",
    "tfstate",
    "tftest",
    "threadsafe",
    "ttfb",
    "userns",
    "zstd"
  ]
}
