prefix_rule(pattern=[["pwd", "cat", "rg", "head", "tail", "wc", "sort"]], decision="allow", justification="Inspect project files and command output for the authorized assessment", match=["rg --files", "cat AGENTS.md"], not_match=["rm -rf /tmp/example"])
prefix_rule(pattern=["sed", "-n"], decision="allow", justification="Read selected file lines")
prefix_rule(pattern=["git", ["status", "diff", "log", "show", "rev-parse", "ls-files", "check-ignore"]], decision="allow", justification="Inspect repository state and changes", match=["git diff --stat"], not_match=["git reset --hard", "git push origin main"])
prefix_rule(pattern=["bun", "run", ["verify", "typecheck", "lint", "format", "format:check", "spell", "test:unit", "test:integration", "test:e2e", "test:coverage", "openapi:check", "openapi:update", "sdk:generate", "skills:build", "kb:record", "docs:build", "docs:reference"]], decision="allow", justification="Run the repository's declared checks, tests, formatters and generators", match=["bun run verify", "bun run test:coverage"], not_match=["bun run stack:prune", "bun run tools:install"])
prefix_rule(pattern=["bun", "run", ["tooling/scripts/check-repo.ts", "tooling/scripts/check-concrete-docs.ts", "tooling/scripts/check-error-cases.ts", "tooling/scripts/check-infra-files.ts", "tooling/scripts/check-interfaces.ts", "tooling/scripts/check-rules.ts", "tooling/scripts/check-testing-area.ts", "tooling/scripts/check-skill-packages.ts", "tooling/scripts/check-skills-fresh.ts", "tooling/scripts/check-sdk-pack.ts", "tooling/scripts/check-structure.ts", "tooling/scripts/check-async-functions.ts", "tooling/scripts/check-docs-scope.ts", "tooling/scripts/check-url-literals.ts", "tooling/scripts/check-openspec.ts", "tooling/scripts/check-plain-language.ts", "tooling/scripts/check-promise-all.ts", "tooling/scripts/check-schemas.ts", "tooling/scripts/check-package-graph.ts", "tooling/scripts/check-agent-knowledge.ts", "tooling/scripts/check-readmes.ts", "tooling/scripts/check-migrations.ts", "tooling/scripts/check-tiers.ts", "tooling/scripts/check-mermaid.ts", "tooling/scripts/check-unit-cases.ts", "tooling/scripts/lint-workflows.ts", "tooling/scripts/dev-status.ts", "tooling/scripts/run-tier.ts", "tooling/scripts/run-coverage.ts", "tooling/scripts/verify.ts", "tooling/scripts/generate-sdk.ts", "tooling/scripts/openapi-check.ts", "tooling/scripts/build-docs.ts", "tooling/scripts/record-kb.ts", "tooling/scripts/secret-scan.ts"]], decision="allow", justification="Run exact project verification entry points", match=["bun run tooling/scripts/check-openspec.ts"], not_match=["bun run /tmp/arbitrary.ts"])
prefix_rule(pattern=["bun", "test"], decision="allow", justification="Run focused regression suites for the project", not_match=["bun -e console.log(1)"])
prefix_rule(pattern=["bun", "audit"], decision="allow", justification="Check installed dependency advisories")
prefix_rule(pattern=["bunx", "--no-install", ["biome", "dprint", "cspell", "tsc", "knip", "secretlint", "commitlint"]], decision="allow", justification="Run installed project checks without downloading executables", match=["bunx --no-install biome ci ."], not_match=["bunx some-package"])
prefix_rule(pattern=["openspec", ["list", "status", "instructions", "validate", "show"]], decision="allow", justification="Read and validate OpenSpec records", match=["openspec validate --all --strict"])
prefix_rule(pattern=["openspec", "new", "change"], decision="allow", justification="Record explicitly requested work in OpenSpec")
prefix_rule(pattern=["openspec", "archive"], decision="allow", justification="Archive completed and verified changes under the project workflow")
prefix_rule(pattern=["codex", "execpolicy", "check"], decision="allow", justification="Validate local command rules without executing their example commands")
prefix_rule(pattern=["git", ["add", "commit", "push", "reset", "clean", "checkout", "restore", "stash"]], decision="prompt", justification="Review git writes, publication and destructive state changes separately")
prefix_rule(pattern=[["rm", "rmdir"]], decision="prompt", justification="Review deletion separately")
prefix_rule(pattern=["bun", ["install", "add", "remove"]], decision="prompt", justification="Review dependency installation and changes separately")
prefix_rule(pattern=["bun", "run", ["stack:up", "stack:down", "stack:prune", "tools:install", "dev", "bench:stack"]], decision="prompt", justification="Review container changes, provisioning and long benchmarks separately")
